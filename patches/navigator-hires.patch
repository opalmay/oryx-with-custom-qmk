diff -ru a/navigator_trackball/navigator.c b/navigator_trackball/navigator.c
--- a/navigator_trackball/navigator.c	2026-10-07 19:32:52.966518161 +0000
+++ b/navigator_trackball/navigator.c	2026-10-07 19:33:15.075368090 +0000
@@ -133,6 +133,60 @@
     // Scroll-only mode: the trackball always scrolls, no cursor movement.
     scroll_active = true;
 #endif
+#ifdef POINTING_DEVICE_HIRES_SCROLL_ENABLE
+    if (scroll_active) {
+        // Hi-res path: the host treats each wheel unit as 1/resolution of a
+        // notch, so send every bit of movement right away instead of waiting
+        // for whole notches. Leftover fractions carry to the next report.
+        const float res = (float)pointing_device_get_hires_scroll_resolution();
+        float dx = (float)mouse_report.x;
+        float dy = (float)mouse_report.y;
+        float gain = res / NAVIGATOR_SCROLL_DIVIDER;
+#    if NAVIGATOR_HIRES_SCROLL_ACCEL_ENABLED
+        // Optional speed-based gain: faster flicks travel further.
+        float mag = (dx < 0 ? -dx : dx) + (dy < 0 ? -dy : dy);
+        float accel = 1.0f + NAVIGATOR_HIRES_SCROLL_ACCEL * mag;
+        if (accel > NAVIGATOR_HIRES_SCROLL_ACCEL_MAX) accel = NAVIGATOR_HIRES_SCROLL_ACCEL_MAX;
+        gain *= accel;
+#    endif
+        scroll_accumulated_h += dx * gain;
+        scroll_accumulated_v += dy * gain;
+        if (scroll_vertical_only) {
+            scroll_accumulated_h = 0.0f;
+        }
+
+        float out_h = scroll_accumulated_h;
+        float out_v = scroll_accumulated_v;
+#    ifdef WHEEL_EXTENDED_REPORT
+        const float lim = 32000.0f;
+#    else
+        const float lim = 127.0f;
+#    endif
+        if (out_h > lim) out_h = lim;
+        if (out_h < -lim) out_h = -lim;
+        if (out_v > lim) out_v = lim;
+        if (out_v < -lim) out_v = -lim;
+        mouse_hv_report_t send_h = (mouse_hv_report_t)out_h; // truncates toward zero
+        mouse_hv_report_t send_v = (mouse_hv_report_t)out_v;
+        scroll_accumulated_h -= (float)send_h;
+        scroll_accumulated_v -= (float)send_v;
+
+#    ifdef NAVIGATOR_SCROLL_INVERT_X
+        mouse_report.h = send_h;
+#    else
+        mouse_report.h = -send_h;
+#    endif
+#    ifdef NAVIGATOR_SCROLL_INVERT_Y
+        mouse_report.v = -send_v;
+#    else
+        mouse_report.v = send_v;
+#    endif
+
+        mouse_report.x = 0;
+        mouse_report.y = 0;
+        return mouse_report;
+    }
+#endif
     if (scroll_active) {
         // Accumulate scroll movement
         scroll_accumulated_h += (float)mouse_report.x / NAVIGATOR_SCROLL_DIVIDER;
diff -ru a/navigator_trackball/navigator.h b/navigator_trackball/navigator.h
--- a/navigator_trackball/navigator.h	2026-10-07 19:32:52.966532892 +0000
+++ b/navigator_trackball/navigator.h	2026-10-07 19:33:15.075534390 +0000
@@ -19,6 +19,20 @@
     #define NAVIGATOR_SCROLL_MAX_SPEED 8.0f
 #endif
 
+// Hi-res scroll tuning (only used with POINTING_DEVICE_HIRES_SCROLL_ENABLE).
+// NAVIGATOR_SCROLL_DIVIDER still sets base speed: sensor counts per notch.
+// Set NAVIGATOR_HIRES_SCROLL_ACCEL > 0 to make fast flicks go further.
+#ifndef NAVIGATOR_HIRES_SCROLL_ACCEL
+    #define NAVIGATOR_HIRES_SCROLL_ACCEL 0.0f
+    #define NAVIGATOR_HIRES_SCROLL_ACCEL_ENABLED 0
+#else
+    #define NAVIGATOR_HIRES_SCROLL_ACCEL_ENABLED 1
+#endif
+
+#ifndef NAVIGATOR_HIRES_SCROLL_ACCEL_MAX
+    #define NAVIGATOR_HIRES_SCROLL_ACCEL_MAX 4.0f
+#endif
+
 #ifndef NAVIGATOR_TRACKBALL_ROTATION
     #define NAVIGATOR_TRACKBALL_ROTATION 0
 #endif
